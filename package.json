{
  "name": "photoshop-manipulate-bridge",
  "version": "1.0.0",
  "description": "Photoshop Generator Plugin with TypeScript and Vite",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "pack:mac": "bash scripts/build-mac-pkg.sh",
    "pack:win": "bash scripts/build-win-installer.sh"
  },
  "keywords": [
    "photoshop",
    "generator",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
